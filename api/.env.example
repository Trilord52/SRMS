# Copy to .env and fill in. Do not commit .env.

NODE_ENV=development
PORT=5000

# Include the database name in the URI.
#   local:  mongodb://localhost:27017/srms
#   atlas:  mongodb+srv://<user>:<password>@<cluster>/srms?retryWrites=true&w=majority
MONGODB_URI=

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Browser origins allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:5173

# Largest accepted upload, in bytes. Default 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Email domain accounts must belong to.
ALLOWED_EMAIL_DOMAIN=bankofabyssinia.com
