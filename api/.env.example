# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Connection string including the database name.
#
# The string Atlas generates ends at the host, so the database name has to be
# appended before the query string. Without it the driver writes to a database
# called "test".
#
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/srms_v2?retryWrites=true&w=majority
# Docker: mongodb://localhost:27017/srms_v2
MONGODB_URI=

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Largest single upload in bytes. Defaults to 10 MB.
MAX_UPLOAD_BYTES=10485760

# Email domain accounts must belong to.
ALLOWED_EMAIL_DOMAIN=bankofabyssinia.com
