# Copy to .env and fill in real values. Do not commit .env.

# MongoDB connection string, including the database name.
# Atlas format: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Local Docker:  mongodb://localhost:27017/srms
MONGODB_URI=

# Secret used to sign and verify JWTs. Use a long random value, unique per environment.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# development | production. Controls whether error responses include details.
NODE_ENV=development

# Port the API listens on.
PORT=5000
